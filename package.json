{
  "name": "facebook-marketplace-mcp",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) server for Facebook Marketplace with Stdio, SSE, Streamable HTTP, and REST API support",
  "main": "dist/index.js",
  "bin": {
    "facebook-marketplace-mcp": "./dist/index.js"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "dev:stdio": "tsx src/index.ts --stdio",
    "test": "tsx test/index.test.ts",
    "prepack": "npm run build"
  },
  "keywords": [
    "facebook",
    "facebook-marketplace",
    "mcp",
    "model-context-protocol",
    "claude-desktop",
    "cursor",
    "antigravity",
    "sse",
    "stdio",
    "streamable-http",
    "rest-api",
    "scraper"
  ],
  "author": "William Axel",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "axios": "1.20.0",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "https-proxy-agent": "9.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.20.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
